{# fichier admin/base.html.twig #}

{% set chemin = app.request.attributes.get("_route") %}

{% extends "base.html.twig" %}

{% block title %}Gestion{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<style>
		label.form-label,  {
			text-shadow: 0 0 4px white;
		}
	</style>
{% endblock %}


{% block javascripts %}
	{# {{ parent() }} #}
	{# {{ importmap('app') }} #}
	{{ importmap('gestion') }}
{% endblock %}

{% block main %}
	<div class="right-aside">
		{{ include ("_communs/_menu.html.twig") }}
		{# ⚠ hack pour gérer le positionnement fixed du menu #}										
		<nav class="navbar navbar-expand-lg navbar-dark bg-dark" >
			<div class="container-fluid">
				<a class="navbar-brand" href="">
					<img src=""  class="vignette">
				</a>
			</div>
		</nav>
		{# ⚠ hack pour gérer le positionnement fixed du menu #}										
        
	</div>
	
	<aside class="bg-dark">
		{{ include ("_communs/admin/_menu_aside.html.twig", {chemin: chemin}) }}
	</aside>

	<main class="right-aside">
		<div class="mx-5 pt-2">
			{% include "_communs/_messages.html.twig" %}
			<h1 class="mt-3 mb-3 text-center d-flex justify-content-between">
				{% block titre %}Gestion de la bibliothèque{% endblock %}
			</h1>
			{% block body %}
				{% block formulaire %}{% endblock %}

				<div>
					<h2>Liste des livres : {{ liste_livres|length }}</h2>
					<div class="card-columns">
						{# EXO : afficher la liste des livres #}
						{% for livre in liste_livres %}
							{% include "livre/card.html.twig" with { "livre": livre } %}

						{% else %}
							<div class="alert alert-info">Aucun livre, ni auteur, ne correspond à votre recherche</div>
						{% endfor %}
					</div>
				</div>
			{% endblock %}
		</div>
	</main>

	{# {% include "_communs/_footer.html.twig" with { "footer_admin": true } %} #}
{% endblock %}
