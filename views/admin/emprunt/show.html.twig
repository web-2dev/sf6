{% extends '_communs/admin/crud/show.html.twig' %}

{% set entite = emprunt %}

{% block fiche_tbody %}
    <tbody>
        <tr>
            <th class="col-2">Numéro</th>
            <td>{{ emprunt.id }}</td>
        </tr>
        <tr>
            <th>Livre emprunté</th>
            <td><a href="{{ path('app_admin_livre_show', {id: emprunt.livre.id}) }}">{{ emprunt.livre.titreAuteur }}</a></td>
        </tr>
        <tr>
            <th>Par le lecteur</th>
            <td><a href="{{ path('app_admin_abonne_show', {id: emprunt.abonne.id}) }}">{{ emprunt.abonne.pseudo (emprunt.abonne.identite) }}</a></td>
        </tr>
        <tr>
            <th>Emprunté le</th>
            <td>{{ emprunt.dateEmprunt|date}}</td>
        </tr>
        <tr>
            <th>Rendu le</th>
            <td>{{ emprunt.dateRetour ? emprunt.dateRetour|date : '' }}</td>
        </tr>
        <tr>
            <th>Retour prévue</th>
            <td>{{ emprunt.datePrevue|date }}</td>
        </tr>
    </tbody>
{% endblock %}
