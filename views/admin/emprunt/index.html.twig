{% extends '_communs/admin/crud/index.html.twig' %}

{% set titreH1 = "emprunts" %}
{% set colonnes = ["Abonné", "Livre", "Emprunt", "Retour", "Prévue"] %}
{% set table = "emprunt" %}

{% block tbody_list %}
        {% for entite in emprunts %}
            <tr>
                <td>{{ entite.id }}</td>
                <td class="position-relative"><a class="stretched-link" href="{{ path('app_admin_abonne_show', {id: entite.abonne.id}) }}">{{ entite.abonne.pseudo }}</a></td>
                <td class="position-relative"><a class="stretched-link" href="{{ path('app_admin_livre_show', {id: entite.livre.id}) }}">{{ entite.livre.titreauteur }}</a></td>
                <td>{{ entite.dateEmprunt|date }}</td>
                <td>{{ entite.dateRetour ? entite.dateRetour|date : '' }}</td>
                <td>{{ entite.datePrevue ? entite.datePrevue|date : '' }}</td>
                {{ include("_communs/admin/crud/case_actions.html.twig") }}
            </tr>
        {% else %}
            <tr>
                <td colspan="5">Liste actuellement vide</td>
            </tr>
        {% endfor %}

    {% endblock %}
