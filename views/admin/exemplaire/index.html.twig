{% extends '_communs/admin/crud/index.html.twig' %}


{% set titreH1 = "Exemplaires" %}
{% set colonnes = ["Lecteur", "Livre", "Complément", "Note", "Commentaire", "Statut", "Acquisition" ] %}
{% set table = "exemplaire" %}


{% block tbody_list %}
    {% for exemplaire in exemplaires %}
        <tr>
            <td>{{ exemplaire.id }}</td>
            <td>{{ exemplaire.biblio.lecteur.pseudo }}</td>
            <td>{{ exemplaire.livre }}</td>
            <td>{{ exemplaire.tome ?? "" }} {{ exemplaire.sousTitre ?? "" }}</td>
            <td>{{ exemplaire.note }}</td>
            <td>{{ exemplaire.commentaire|extrait(10) }}</td>
            <td>{{ exemplaire.statut.value }}</td>
            <td>{{ exemplaire.acquisition }}</td>
            <td>
                <a href="{{ path('app_admin_exemplaire_show', {'id': exemplaire.id}) }}">show</a>
                <a href="{{ path('app_admin_exemplaire_edit', {'id': exemplaire.id}) }}">edit</a>
            </td>
        </tr>
    {% else %}
        <tr>
            <td colspan="9">Aucun exemplaire ajouté à une bibliothèque actuellement</td>
        </tr>
    {% endfor %}
{% endblock %}
