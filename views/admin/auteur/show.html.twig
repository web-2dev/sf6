{% extends '_communs/admin/crud/show.html.twig' %}

{% set entite = auteur %}

{% block fiche_tbody %}
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ auteur.id }}</td>
            </tr>
            <tr>
                <th>Prénom</th>
                <td>{{ auteur.prenom }}</td>
            </tr>
            <tr>
                <th>Nom</th>
                <td>{{ auteur.nom }}</td>
            </tr>
            <tr>
                <th>Biographie</th>
                <td>{{ auteur.biographie }}</td>
            </tr>
            <tr>
                <th>Naissance - Décès</th>
                <td>{{ auteur.naissance ? auteur.naissance|date() : '' }} - {{ auteur.deces ? auteur.deces|date() : '' }}</td>
            </tr>
            <tr>
                <th>Âge</th>
                <td>TODO</td>
            </tr>
            <tr>
                <th>Livres</th>
                <td>
                    <table class="table table-bordered">
                        <thead class="table-info"  style="position: sticky; top: 80px; z-index: 2;">
                            <tr>
                                <th class="col-1">ID</th>
                                <th>Titre</th>
                                <th>Genres</th>
                                <th class="col-1">Popularité</th>
                            </tr>
                        </thead>
                        <tbody>
                        {% for livre in auteur.livres %}
                            <tr>
                                <td>{{ livre.id }}</td>
                                <td class="position-relative">
                                    <a class="stretched-link" href="{{ path('app_admin_livre_show', {id: livre.id}) }}">{{ livre.couverture|img("couvertures", "vignette")|raw }} {{ livre.titre }}</a>
                                </td>
                                <td>
                                    {% for genre in livre.genres %}
                                        <a href="{{ path ('app_admin_genre_show', {id: genre.id}) }}">{{ genre.libelle }}</a>{% if !loop.last %}, {% endif %}
                                    {% endfor %}
                                </td>
                                <td>Présent {{ livre.exemplaires|length }} bibliothèques persos <br> xx avis</td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="4">Aucun livre n'est encore lié à cet auteur</td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>        
                </td>
            </tr>
        </tbody>
{% endblock %}
