{% extends '_communs/admin/crud/liste.html.twig' %}

{% set titreH1 = "auteurs" %}
{% set colonnes = [ "Nom", "Biographie", "Naissance", "Décès" ] %}
{% set table = "auteur" %}


{% block tbody_list %}
        {% for entite in auteurs %}
            <tr>
                <td>{{ entite.id }}</td>
                <td>{{ entite.identite }}</td>
                <td>{{ entite.biographie|extrait(10) }}</td>
                <td>{{ entite.naissance ? entite.naissance|date() : '' }}</td>
                <td>{{ entite.deces     ? entite.deces|date()     : '' }}</td>
                <td>
                    {{ include("_communs/admin/crud/case_actions.html.twig") }}
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="7">Liste actuellement vide</td>
            </tr>
        {% endfor %}
{% endblock %}
