{% extends '_communs/admin/crud/index.html.twig' %}

{% set titreH1 = "auteurs" %}
{% set colonnes = {"Nom": true, "Dates": true, "Biographie": false, "Bibliographie": true} %}
{% set table = "auteur" %}


{% block tbody_list %}
        {% for entite in auteurs %}
            <tr id={{ entite.id }}>
                <td>{{ entite.id }}</td>
                <td>{{ entite.identite }}</td>
                <td>{{ entite.naissance|dateFR ~ " - " ~ entite.deces|dateFR() }}</td>
                <td>{{ entite.biographie|extrait(10) }}</td>
                <td>{{ entite.livres|length }}</td>
                {{ include("_communs/admin/crud/case_actions.html.twig") }}
            </tr>
        {% else %}
            <tr>
                <td colspan="7">Liste actuellement vide</td>
            </tr>
        {% endfor %}
{% endblock %}

{% block javascripts_end %}
	{{ parent() }}

    <script>
    document.querySelectorAll('.redirect-url').forEach(input => { input.value = window.location.href; });
    </script>
{% endblock %}
