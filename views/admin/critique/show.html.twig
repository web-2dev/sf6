{% extends '_communs/admin/crud/show.html.twig' %}

{% set entite = critique %}

{% block fiche_tbody %}
    <tbody>
        <tr>
            <th class="col-2">Du livre</th>
            <td><a href="{{ path('app_admin_livre_show', {id: critique.livre.id}) }}">{{ critique.livre.titreAuteur }}</a></td>
        </tr>

        <tr>
            <th>Par le lecteur</th>
            <td><a href="{{ path('app_admin_abonne_show', {id: critique.abonne.id}) }}">{{ critique.abonne.pseudo (critique.abonne.identite) }}</a></td>
        <tr>
            <th>Qui donne la note de </th>
            <td>{{ critique.note }} <i class="fa fa-book"></i></td>
        </tr>
        <tr>
            <th>Et écrit la critique suivante</th>
            <td>{{ critique.commentaire }}</td>
        </tr>
    </tbody>
{% endblock %}
