{% extends '_communs/admin/crud/liste.html.twig' %}

{% set titreH1 = "critiques" %}
{% set colonnes = ["Lecteur", "Livre", "Note", "Commentaire"] %}
{% set table = "critique" %}
                

{% block tbody_list %}

        {% for entite in critiques %}
            <tr>
                <td>{{ entite.id }}</td>
                <td>{{ entite.abonne.pseudo }}</td>
                <td>{{ entite.livre.titreAuteur }}</td>
                <td>{{ entite.note }}</td>
                <td>{{ entite.commentaire }}</td>
                <td>{{ include("_communs/admin/crud/case_actions.html.twig") }}</td>
            </tr>
        {% else %}
            <tr>
                <td colspan="4">Liste actuellement vide</td>
            </tr>
        {% endfor %}

    {% endblock %}
