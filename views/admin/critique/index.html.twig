{% extends '_communs/admin/crud/index.html.twig' %}

{% set titreH1 = "critiques" %}
{% set colonnes = ["Lecteur", "Livre", "Note", "Commentaire"] %}
{% set table = "critique" %}
                

{% block tbody_list %}

        {% for entite in critiques %}
            <tr>
                <td>{{ entite.id }}</td>
                <td class="position-relative"><a href="{{ path('app_admin_abonne_show', {id: entite.abonne.id}) }}">{{ entite.abonne.pseudo }}</a></td>
                <td class="position-relative"><a href="{{ path('app_admin_livre_show', {id: entite.livre.id}) }}">{{ entite.livre.titreAuteur }}</a></td>
                <td>{{ entite.note }}</td>
                <td>{{ entite.commentaire }}</td>
                {{ include("_communs/admin/crud/case_actions.html.twig") }}
            </tr>
        {% else %}
            <tr>
                <td colspan="4">Liste actuellement vide</td>
            </tr>
        {% endfor %}

    {% endblock %}
