{% extends 'admin/base.html.twig' %}

{% block title %}Abonne index{% endblock %}

{% block body %}
    <h1>Abonne index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Roles</th>
                <th>Pseudo</th>
                <th>Nom</th>
                <th>Naissance</th>
                <th>Avis</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for abonne in abonnes %}
            <tr>
                <td>{{ abonne.id }}</td>
                <td>{{ abonne|autorisations }}</td>
                <td>{{ abonne.pseudo }}</td>
                <td>{{ abonne.identite }}</td>
                <td>{{ abonne.naissance ? abonne.naissance|date() : '' }}</td>
                <td>{{ abonne.critiques|length }} </td>
                <td>
                    <a href="{{ path('app_admin_abonne_show', {'id': abonne.id}) }}">show</a>
                    <a href="{{ path('app_admin_abonne_edit', {'id': abonne.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="9">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_admin_abonne_new') }}">Create new</a>
{% endblock %}
