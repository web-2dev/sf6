{% extends '_communs/admin/crud/liste.html.twig' %}

{% set titreH1 = "usagers" %}
{% set colonnes = ["Rôles", "Pseudo", "Nom", "Date de naissance", "Avis"] %}
{% set table = "abonne" %}


{% block tbody_list %}
    {% for abonne in abonnes %}
        <tr>
            <td>{{ abonne.id }}</td>
            <td>{{ abonne|autorisations }}</td>
            <td>{{ abonne.pseudo }}</td>
            <td>{{ abonne.identite }}</td>
            <td>{{ abonne.naissance ? abonne.naissance|date() : '' }}</td>
            <td>{{ abonne.critiques|length }} </td>
            <td>
                {{ include("_communs/admin/crud/case_actions.html.twig", {entite: abonne}) }}
            </td>
        </tr>
    {% else %}
        <tr>
            <td colspan="9">Liste actuellement vide</td>
        </tr>
    {% endfor %}
{% endblock %}

