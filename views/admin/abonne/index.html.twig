{% extends '_communs/admin/crud/index.html.twig' %}

{% set titreH1 = "usagers" %}
{% set colonnes = ["Rôles", "Pseudo", "Nom", "Âge", "Emprunts", "Biblio" ] %}
{% set table = "abonne" %}


{% block tbody_list %}
    {% for abonne in abonnes %}
        <tr>
            <td>{{ abonne.id }}</td>
            <td class="col-1" >{{ abonne|autorisations }}</td>
            <td>{{ abonne.pseudo }}</td>
            <td>{{ abonne.identite }}</td>
            <td class="col-1">{{ abonne.naissance ? abonne.naissance|age : '' }}</td>
            <td class="text-center">{{ abonne.emprunts|length ?: "-" }} </td>
            <td class="text-center">{{ abonne.biblio ? abonne.biblio.exemplaires|length ?: "-" : "❌" }} </td>
            {{ include("_communs/admin/crud/case_actions.html.twig", {entite: abonne}) }}
        </tr>
    {% else %}
        <tr>
            <td colspan="9">Liste actuellement vide</td>
        </tr>
    {% endfor %}
{% endblock %}

