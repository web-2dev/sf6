{% extends 'admin/base.html.twig' %}

{% block title %}Abonne index{% endblock %}

{% block body %}
    <h1>Abonne index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Identité</th>
                <th>Pseudo</th>
                <th>Droits</th>
                <th>Adresse</th>
                <th>Naissance</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for abonne in abonnes %}
            <tr>
                <td>{{ abonne.id }}</td>
                <td>{{ abonne.identite }}</td>
                <td>{{ abonne.pseudo }}</td>
                <td>{{ abonne|autorisations }} </td>
                <td>{{ abonne.adresse|extrait(5) }}</td>
                <td>{{ abonne.naissance ? abonne.naissance|date("d/m/y") : '' }}</td>
                <td>
                    <a href="{{ path('app_admin_abonne_show', {'id': abonne.id}) }}"><i class="fa fa-eye"></i></a>
                    <a href="{{ path('app_admin_abonne_edit', {'id': abonne.id}) }}"><i class="fa fa-edit"></i></a>
    </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="9">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_admin_abonne_new') }}">Create new</a>
{% endblock %}
