{% extends '_communs/admin/crud/liste.html.twig' %}

{% set titreH1 = "genres" %}
{% set colonnes = ["Libellé", "Mots-clés"] %}
{% set table = "genre" %}

{% block tbody_list %}

    {% for entite in genres %}
        <tr>
            <td>{{ entite.id }}</td>
            <td>{{ entite.libelle }}</td>
            <td>{{ entite.motsCles }}</td>
            <td>{{ include("_communs/admin/crud/case_actions.html.twig") }}</td>
        </tr>
    {% else %}
        <tr>
            <td colspan="4">Liste actuellement vide</td>
        </tr>
    {% endfor %}

    {% endblock %}
