{% extends '_communs/admin/crud/show.html.twig' %}

{% set entite = genre %}

{% block fiche_tbody %}

<tbody>
    <tr>
        <th>Id</th>
        <td>{{ genre.id }}</td>
    </tr>
    <tr>
        <th>Libellé</th>
        <td>{{ genre.libelle }}</td>
    </tr>
    <tr>
        <th>Mots-clés</th>
        <td>{{ genre.motsCles }}</td>
    </tr>

    <tr>
        <th><span style="position: sticky; top: 80px;">Livres</span></th>
        <td>
            {% for livre in genre.livres %}
            <p>Livre n°{{ livre.id }} dont le titre est 
                <a href="{{ path('app_admin_livre_show', {id: livre.id}) }}">{{ livre.titre }}</a>
                de <a href="{{ path ('app_admin_auteur_show', {id: livre.auteur.id}) }}">{{ livre.auteur.identite }}</a> 
                , présent dans {{ livre.exemplaires|length }} bibliothèques persos.
            </p>
            {% else %}
                <p>Aucun livre n'est associé à ce genre</p>
            {% endfor %}
        </td>

    </tr>
</tbody>

{% endblock %}

