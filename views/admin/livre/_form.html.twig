{% set livre = form.vars.value %}

<style>
    fieldset:not(fieldset fieldset) { background-color: #bfb9b985; border: 1px solid; padding: 1em;}
</style>

<div class="d-flex gap-2">
    <fieldset class="col">
        <legend></legend>
        {{ form_row(form.titre) }}
        {{ form_row(form.auteur) }}
        {{ form_row(form.synopsis) }}
    </fieldset>

    <fieldset class="col">
        <div class="row">
            <img src="{{ chemin_couvertures ~ (livre.couverture ?: 'no_cover.jpg') }}" class="col-2">
        
            {{ form_row(form.couverture, {
                    row_attr: {
                        class: "col-10"
                    }
                } )}}
        </div>
        <hr>
        {{ form_row(form.genres) }}
    </fieldset>

</div>


