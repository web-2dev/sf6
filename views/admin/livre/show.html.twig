{% extends 'admin/base.html.twig' %}

{% block titre %}Livre n°{{ livre.id }}{% endblock %}
{% block title %}Livre{% endblock %}

{% block body %}

    <table class="table">
        <tbody>
            <tr>
                <th class="col-1">Id</th>
                <td>{{ livre.id }}</td>
            </tr>
            <tr>
                <th>Titre</th>
                <td>{{ livre.titre }}</td>
            </tr>
            <tr>
                <th>Synopsis</th>
                <td>{{ livre.synopsis }}</td>
            </tr>
            <tr>
                <th>Couverture</th>
                <td>{{ livre.couverture|img("couvertures", "miniature") }}</td>
            </tr>
            <tr>
                <th>URL</th>
                <td>{{ livre.url }}</td>
            </tr>
            <tr>
                <th>Critiques</th>
                <td>
                    <div class="col-9">
                        {% for critique in livre.critiques %}
                            <div class="d-flex">
                                <span class="col-3">{{ critique.abonne.pseudo }} </span>
                                <span class="col-2"> {{ critique.note }} <i class="fa fa-book"></i> / 10 </span>
                                <span class="col-7"> {{ critique.commentaire }} </span>
                            </div>
                            <hr>
                        {% endfor %}
                    </div>
                </td>
            </tr>
        </tbody>
    </table>

    {{ include("_communs/admin/crud/case_actions.html.twig", { entite: livre}) }}
{% endblock %}
