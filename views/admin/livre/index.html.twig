{% extends '_communs/admin/crud/liste.html.twig' %}

{% set titreH1 = "livres" %}
{% set colonnes = ["Couverture", "Titre", "Auteur", "Genres", "Avis"] %}
{% set table = "livre" %}

{% block tbody_list %}

    {% for entite in livres %}
        <tr>
            <td>{{ entite.id }}</td>
            <td class="text-center">{{ entite.couverture|img("couvertures", "vignette") }}</td>
            <td>{{ entite.titre }}</td>
            <td>{{ entite.auteur }}</td>
            <td>{{ entite.genres|join(', ') }}</td>
            <th>{{ entite.critiques|length }}</th>
            <td>{{ include("_communs/admin/crud/case_actions.html.twig") }}</td>
        </tr>
    {% else %}
        <tr>
            <td colspan="6">Liste actuellement vide</td>
        </tr>
    {% endfor %}

    {% endblock %}
