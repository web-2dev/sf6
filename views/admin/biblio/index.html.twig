{% extends '_communs/admin/crud/index.html.twig' %}

{% set titreH1 = "Biblios persos" %}
{% set colonnes = ["Nom", "Lecteur", "Livres"] %}
{% set table = "biblio" %}

{% block tbody_list %}
    <tbody>
        {% for entite in biblios %}
            <tr>
                <td>{{ entite.id }}</td>
                <td>{{ entite.nom }}</td>
                <td>{{ entite.lecteur }}</td>
                <td>{{ entite.exemplaires|length }}</td>
                {{ include("_communs/admin/crud/case_actions.html.twig") }}
            </tr>
        {% else %}
            <tr>
                <td colspan="6">Liste actuellement vide</td>
            </tr>
        {% endfor %}
        </tbody>
{% endblock %}
