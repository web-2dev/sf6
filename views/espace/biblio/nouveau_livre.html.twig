{% extends 'base.html.twig' %}

{% block title %}Ajouter un livre (et un exemplaire à ma bibliothèque){% endblock %}

{% block body %}
    {{ form_start(form) }}
        {% set livre = form.vars.value %}

        <div class="d-flex gap-2">
            <fieldset class="col">
                <legend></legend>
                {{ form_row(form.titre) }}
                {{ form_row(form.auteur) }}
                {{ form_row(form.synopsis) }}
            </fieldset>

            <fieldset class="col">
                <div class="row">
                    <img src="{{ chemin_couvertures ~ (livre.couverture ?: 'no_cover.jpg') }}" class="col-2">
                
                    {{ form_row(form.couverture, {
                            row_attr: {
                                class: "col-10"
                            }
                        } )}}
                </div>
                <hr>
                {{ form_row(form.genres) }}
            </fieldset>

        </div>


        <div class="mt-4">
            <button class="btn btn-primary d-fond-princ"><i class="fa fa-save"></i>  {{ button_label|default('Ajouter') }}</button>
            <a class="btn btn-danger d-fond-erreur" href="{{ path ('app_espace_biblio') }}"><i class="fa fa-reply"></i> Annuler </a>
        </div>
    {{ form_end(form) }}
{% endblock %}
