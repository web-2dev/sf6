{% extends "admin/base.html.twig" %}

{% block titre %}Liste des {{ titreH1 }}
    <a href="{{ path('app_admin_' ~ table ~'_new') }}" class=" btn-primary">
        <i class="fa fa-square-plus"></i>
    </a>
{% endblock %}

{% block body %}
    <table class="table table-bordered table-hover">
        <thead class="table-warning"  style="position: sticky;top: 80px; z-index: 100">
            <tr>
                <th><i class="fa fa-key"></i></th>
                {% for colonne in colonnes %}
                    <th>
                        <a href="?col={{ colonne|lower }}&dir=asc"><i class="fa fa-arrow-down-a-z text-dark"></i></a>
                        {{colonne}}
                        <a href="?col={{ colonne|lower }}&dir=desc"><i class="fa fa-arrow-down-z-a text-dark"></i></a>
                    </th>
                {% endfor %}
                <th><i class="fa fa-screwdriver-wrench"></i></th>
            </tr>
        </thead>
        <tbody>
            {% block tbody_list %}{% endblock %}
        </tbody>
    </table>


{% endblock %}