{% extends 'base.html.twig' %}
{% block titre %}
    Résultats de la recherche de : 
                    
                
            
        
    <code>
        {{ search_word }}
    </code>
{% endblock %}
{% block body %}
    <ul class="list-group">
        <li class="list-group-item active">
            Auteurs
                                            
                                
                    
        </li>
        {% for auteur in auteurs %}
            <li class="list-group-item ">
                {{ auteur.identite }}
            </li>
        {% else %}
            <li class="list-group-item">
                Aucun résultat trouvé
                            
            </li>
        {% endfor %}
    </ul>

    <ul class="list-group">
        <li class="list-group-item active">
            Livres
                                            
                                
                    
        </li>
        {% for livre in livres %}
            <li class="list-group-item ">
                {{ livre.titre }}
            </li>
        {% else %}
            <li class="list-group-item">
                Aucun résultat trouvé
                            
            </li>
        {% endfor %}
    </ul>

    <ul class="list-group">
        <li class="list-group-item active">
            Genres
                                            
                                
                    
        </li>
        {% for genre in genres %}
            <li class="list-group-item ">
                {{ genre.libelle }}
            </li>
        {% else %}
            <li class="list-group-item">
                Aucun résultat trouvé
                            
            </li>
        {% endfor %}
    </ul>

{% endblock %}
