{% extends 'base.html.twig' %}
{% block title %}
    Livres
{% endblock %}
{% block body %}
    <div class="row mx-0">
        <h2 class="col">
            Tous les livres
        </h2>
        <h3 class="col-1">
            (x
            {{ livres|length }}
            )
        </h3>
    </div>
    {# <div class="card-group"> #}
    <div class="row row-cols-1 row-cols-md-3 g-4 px-3">
        {% for livre in livres %}
            {% include "livre/card.html.twig" %}
        {% else %}
            <div class="alert alert-info">
                Aucun livre trouvé
            </div>
        {% endfor %}
    </div>
{# </div> #}
{% endblock %}
