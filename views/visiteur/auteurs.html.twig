{% extends 'base.html.twig' %}

{% block title %}Auteurs{% endblock %}
{% block titre %}{{ word is defined ? "Résultats de la recherche de <i><code>"~ word ~"</code></i>" : titre|default("Tous les auteurs") }}{% endblock %}


{% block body %}
    <h2 class="col">×{{ auteurs|length }} auteurs</h2>

{# <div class="card-group"> #}
<div class="row row-cols-1 row-cols-sm-2 row-cols-md-4 gx-4 px-3">
    {% for auteur in auteurs %}
        {# {% if loop.first %}<div class="row">{% endif %} #}
        {% include "auteur/card.html.twig" %}
        {# {% if loop.last %}</div>{% endif %} #}
        
    {% else %}
        <div class="alert alert-info">Aucun auteur trouvé</div>
    {% endfor %}
</div>

<style>
    span.test { display: inline-block; height: 2em; }
</style>

{% endblock %}