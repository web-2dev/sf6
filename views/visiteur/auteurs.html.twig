{% extends 'base.html.twig' %}

{% block title %}Auteurs{% endblock %}
{% block titre %}{{titre|default('Tous les auteurs')}}{% endblock %}


{% block body %}
<div class="row mx-0">
    <h2 class="col">x{{ auteurs|length }} auteurs</h2>
</div>

{# <div class="card-group"> #}
<div class="row row-cols-1 row-cols-md-3 g-4 px-3">
    {% for auteur in auteurs %}
        {% include "auteur/card.html.twig" %}
    {% else %}
        <div class="alert alert-info">Aucun auteur trouvé</div>
    {% endfor %}
</div>
{# </div> #}


{% endblock %}