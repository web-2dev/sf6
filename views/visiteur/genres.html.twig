{% extends 'base.html.twig' %}
{% block title %}
    Genres
{% endblock %}
{% block body %}
    <div class="row mx-0">
        <h2 class="col">
            Tous les genres
        </h2>
        <h3 class="col-1">
            (x
            {{ genres|length }}
            )
        </h3>
    </div>
    <div class="row row-cols-1 row-cols-md-3 g-4 px-3">
        {% for genre in genres %}
            {% include "genre/card.html.twig" %}
        {% else %}
            <div class="alert alert-info">
                Aucun genre trouvé
            </div>
        {% endfor %}
    </div>
{% endblock %}
