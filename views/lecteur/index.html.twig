{% extends 'base.html.twig' %}

{% block title %}Espace Lecteur{% endblock %}
{% block titre %}{{ block("title") }}  {% endblock %}

{% block body %}
    <div class="row">
        <div class="col">

            <ul class="list-group mb-3">
                <li class="list-group-item bg-secondary"><h4>Mes lectures</h4></li>
                {% for lecture in lectures %}
                    <li class="list-group-item position-relative"><a href="{{ path('app_visiteur_livre_fiche', {url: lecture.livre.url}) }}" class="stretched-link">{{ lecture.livre }}</a></li>
                {% endfor %}
            </ul>

            <ul class="list-group mb-3">
                <li class="list-group-item bg-secondary"><h4>Mes emprunts</h4></li>
                {% for emprunt in app.user.emprunts %}
                    <li class="list-group-item">{{ emprunt.livre.titreAuteur }} : <i>emprunté du</i> {{ emprunt.dateEmprunt|date() }} <i>au</i> {{ emprunt.dateRetour|date }}</li>
                {% endfor %}
            </ul>

            <ul class="list-group mb-3">
                <li class="list-group-item bg-secondary"><h4>Mes critiques</h4></li>
                {% for critique in app.user.critiques %}
                    <li class="list-group-item">
                        <mark class="me-3"><a href="{{ path('app_visiteur_livre_fiche', {url: critique.livre.url}) }}" class="stretched-link">{{ critique.livre.titreAuteur }}</a></mark> {{ critique.note }} <i class="fa fa-star me-3"></i> <i>{{ critique.commentaire|extrait(30) }}</i>

                    </li>
                {% endfor %}
            </ul>
        </div>

        <div class="col">
            <ul class="list-group">
                <li class="list-group-item bg-secondary"><h4>Mes informations</h4></li>
                <li class="list-group-item">
                    <table>
                        <tr>
                            <th>Catégorie</th>
                            <td>{{ app.user|autorisations }}</td>
                        </tr>
                    </table>
                </li>

                <li class="list-group-item">
                    <table>
                        <tr>
                            <th>PSEUDO</th>
                            <td>{{ app.user.pseudo }}</td>
                        </tr>
                    </table>
                </li>

                <li class="list-group-item">
                    <table>
                        <tr>
                            <th>Identité</th>
                            <td>{{ app.user.nomcomplet }}</td>
                        </tr>
                    </table>
                </li>

                <li class="list-group-item">
                    <table>
                        <tr>
                            <th>Date de naissance</th>
                            <td>{{ app.user.naissance ? app.user.naissance|date : "-" }} </td>
                        </tr>
                    </table>
                </li>


                <li class="list-group-item">
                    <table>
                        <tr>
                            <th>E-mail</th>
                            <td>***</td>
                        </tr>
                    </table>
                </li>

                <li class="list-group-item">
                    <table>
                        <tr>
                            <th>Adresse</th>
                            <td>{{ app.user.adresse }}</td>
                        </tr>
                    </table>
                </li>
            </ul>
        </div>
    
    </div>
{% endblock %}
