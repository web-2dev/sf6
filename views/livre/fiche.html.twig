{% extends "base.html.twig" %}

{% block title %}Fiche Livre{% endblock %}

{% block titre %}Fiche du livre n°{{ livre.id }}{% endblock %}

{% block body %}
    <div class="row">
        <div class="col-3">
            {{ livre.couverture|img("couvertures", "adapt")|raw }}
            {# {{ chemin_couvertures ~ livre.couverture }} #}
        </div>
        <div class="col-9">
            <ul class="list-group ">
                <li class="list-group-item">
                    <h2 class="row">
                        <strong class="col-3 text-right">Titre</strong>
                        <span class="col-9  d-flex justify-content-between align-items-center" >
                            {{ livre.titre }}

                            <span class="badge bg-primary text-success"> {{ livre|dispo ? "✔" : "❌" }}</span>
                        </span>

                    </h2>
                </li>
                
                <li class="list-group-item">
                    <h3 class="row">
                        <strong class="col-3 text-right">Auteur</strong>
                        <span class="col-9">{{ livre.auteur.identite }}</span>
                    </h3>
                </li>
                
                <li class="list-group-item">
                    <h4 class="row">
                        <strong class="col-3 text-right">Genres</strong>
                        {# 💬 COURS : La variable 'loop' permet d'avoir des informations sur les itérations #}
                        <span class="col-9">
                            {% for genre in livre.genres %}
                                <a href="{{ path('app_visiteur_genre_fiche', {libelle: genre.libelle}) }}">{{ genre.libelle }}</a>  {{ loop.last ? "" : ", " }}
                            {% endfor %}
                            {# On peut aussi utiliser la fonction getToutescategories ajoutée dans l'entité Categorie #}
                            {# {{ livre.toutesCategories }}  #}
                        </span>
                    </h4>
                </li>

                <li class="list-group-item">
                    <h5 class="row">
                        <strong class="col-3 text-right">Synopsis</strong>
                        <span class="col-9">{{ livre.synopsis }}</span>
                    </h5>
                </li>

                <li class="list-group-item">
                    <h5 class="row">
                        <strong class="col-3 text-right">Popularité</strong>
                        <span class="col-9"> 
                            <span class="badge bg-primary text-dark">Emprunté {{ livre.emprunts|length }} fois </span>
                        </span>
                    </h5>
                </li>

                <li class="list-group-item">
                    <h6 class="row">
                        <strong class="col-3 text-right">Critiques</strong>
                        <div class="col-9">
                            {% if livre is livreDejaEmprunte %}
                                {% if livre is not livreDejaCommente %}
                                    <a href="{{ path("app_lecteur_critique", {"id": livre.id}) }}" class="btn btn-warning">
                                        <i class="fa fa-star"></i> Noter / Commenter
                                    </a>
                                {% endif %}
                            {% else %}
                                <a href="" class="btn btn-warning disabled" title="⚠ Il faut déjà avoir emprunté le livre">
                                    <i class="fa fa-star"></i> Noter / Commenter
                                </a>
                            {% endif %}                         
                                
                            {% for critique in livre.critiques %}
                                <hr>
                                <div class="d-flex">
                                    <span class="col-3">{{ critique.abonne.pseudo }} </span>
                                    <span class="col-2"> {{ critique.note }} <i class="fa fa-book"></i> / 10 </span>
                                    <span class="col-7"> {{ critique.commentaire }} </span>
                                </div>
                            {% endfor %}
                        </div>
                    </h6>
                </li>


            </ul> 
        </div>
    </div>
    

    <a href="{{ path("app_home") }}" class="btn btn-primary mt-5"><i class="fa fa-home"> Retour</i></a>

    {% if is_granted("ROLE_BIBLIO") %}
        <a href="{{ "" }}" class="btn btn-success mt-5 disabled"><i class="fa fa-cart"></i> Enregistrer un emprunt</a>
    {% endif %}

    {% if is_granted("ROLE_LECTEUR") %}
        <a href="{{ "" }}" class="btn btn-success mt-5 disabled"><i class="fa fa-shopping-cart"></i> Réserver</a>
    {% endif %}


{% endblock %}